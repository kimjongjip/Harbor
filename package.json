{
  "name": "codex-harbor",
  "version": "1.2.1",
  "private": true,
  "main": "desktop/main.cjs",
  "productName": "Harbor",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "desktop": "electron .",
    "build:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test": "tsx --test src/server/*.test.ts src/client/*.test.ts",
    "audit:publication": "node scripts/audit-publication.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "mermaid": "12.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kimjongjip/Harbor.git"
  }
}
